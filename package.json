{
  "name": "ra-achadinhos",
  "version": "0.1.0",
  "description": "RA Achadinhos - Plataforma profissional de descoberta de produtos e ofertas com links de afiliados",
  "main": "server/app.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch server/app.js",
    "start": "NODE_ENV=production node server/app.js",
    "test": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "lint": "eslint . --ext .js --fix",
    "db:migrate": "node database/migrate.js",
    "db:seed": "node database/seed.js",
    "admin:create": "node scripts/create-admin.js"
  },
  "keywords": [
    "affiliate",
    "catalog",
    "ecommerce",
    "ofertas",
    "marketing"
  ],
  "author": "RA Achadinhos",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.21.0",
    "helmet": "^8.0.0",
    "joi": "^17.6.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.2",
    "pg": "^8.17.0",
    "pg-promise": "^11.5.4",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
