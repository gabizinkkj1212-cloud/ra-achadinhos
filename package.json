{
  "name": "ra-achadinhos",
  "version": "0.1.0",
  "description": "RA Achadinhos - Plataforma profissional de descoberta de produtos e ofertas com links de afiliados",
  "main": "server/app.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node server/app.js",
    "start": "NODE_ENV=production node server/app.js",
    "test": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint . --ext .js --fix",
    "db:migrate": "node database/migrate.js",
    "db:seed": "node database/seed.js",
    "admin:create": "node scripts/create-admin.js"
  },
  "keywords": [
    "e-commerce",
    "affiliate",
    "produtos",
    "ofertas",
    "marketplace"
  ],
  "author": "RA Achadinhos",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.1.2",
    "joi": "^17.11.0",
    "uuid": "^9.0.1",
    "cors": "^2.8.5",
    "node-cron": "^3.0.2",
    "express-session": "^1.17.3",
    "pg-promise": "^11.5.4",
    "csv-parser": "^3.0.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
